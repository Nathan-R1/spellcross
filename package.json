{
  "name": "spellcross",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --exclude \"tests/sim/**\"",
    "test:watch": "vitest --exclude \"tests/sim/**\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "assets:manifest": "node scripts/build-asset-manifest.mjs",
    "sim": "vitest run tests/sim --silent=false"
  },
  "dependencies": {
    "react": "19",
    "react-dom": "19",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-wasm32-wasi": "1.2.19",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@^4.68.0"
    }
  }
}
